# Copy to deploy/config.env and fill in. deploy/config.env is gitignored.

# Web server (ranh.app)
WEB_DOMAIN=ranh.app
WEB_SSH_HOST=ranh.app

# API server (api.ranh.app)
API_DOMAIN=api.ranh.app
API_SSH_HOST=api.ranh.app

# SSH configuration (default user/port used for both servers)
SSH_USER=root
SSH_PORT=22

# Required on first init for Let's Encrypt certificates
ACME_EMAIL=admin@ranh.app

# Root password used to create the app DB user via arangosh (first server init)
ARANGO_ROOT_PASSWORD=

# Optional overrides:
# SSH_HOST=               # Fallback if WEB_SSH_HOST / API_SSH_HOST are not set
# TRAEFIK_VERSION=v3.5.3
# NGINX_WEB_PORT=8081
# NGINX_API_PORT=8082
